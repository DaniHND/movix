# Normalizar a LF en el repositorio (deploy a Linux/Railway)
* text=auto eol=lf
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.env.example text eol=lf

# Binarios — sin conversión
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
