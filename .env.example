# Copia este archivo a .env y completa los valores
# cp .env.example .env

# Base de datos
DB_HOST=localhost
DB_NAME=movix_db
DB_USER=root
DB_PASS=

# Aplicación
# En Laragon con subdirectorio: http://localhost/Movix/public
# Con virtual host: http://movix.test
APP_URL=http://localhost/Movix/public
APP_ENV=development

# Google Maps
GOOGLE_MAPS_KEY=

# Firebase Cloud Messaging
# Clave del servidor: Firebase Console → Configuración → Cloud Messaging → Clave del servidor (legacy)
FCM_SERVER_KEY=

# SDK web — Firebase Console → Configuración → General → Tus apps → Web
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# VAPID Key — Firebase Console → Cloud Messaging → Certificados web push
FIREBASE_VAPID_KEY=

# Email (SMTP)
# Desarrollo: Mailpit en localhost:1025 (sin credenciales)
# Producción: usar SMTP real
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
